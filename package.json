{
  "name": "sunny-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && npm run check:typography",
    "check:typography": "node scripts/check-typography.mjs",
    "agent:checkpoint:setup": "node --import tsx scripts/setup-langgraph-checkpoints.ts",
    "agent:e2e-provider": "node scripts/agent-e2e-provider.mjs",
    "verify:migrations": "node --import tsx scripts/ensure-migrations-for-build.mjs",
    "release:prepare": "npm run migrate && npm run agent:checkpoint:setup && npm run verify:migrations",
    "test": "npm run test:deterministic",
    "test:deterministic": "npm run test:agent && npm run test:agent:contracts && npm run test:agent:planning && npm run test:agent:schedule && npm run test:content",
    "test:agent": "PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 AGENT_DISABLE_LLM=1 TSX_TSCONFIG_PATH=tsconfig.agent-test.json tsc -p tsconfig.agent-test.json && PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 AGENT_DISABLE_LLM=1 TSX_TSCONFIG_PATH=tsconfig.agent-test.json node --import tsx --test tests/agent/*.test.ts tests/agent/ops/*.test.ts tests/agent/ops/*.test.tsx tests/agent/review/*.test.ts tests/agent/review/*.test.tsx",
    "test:agent:contracts": "PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 AGENT_DISABLE_LLM=1 TSX_TSCONFIG_PATH=tsconfig.agent-test.json node --import tsx --test tests/agent/chat-pipeline/*.test.ts tests/agent/llm/*.test.ts tests/agent/orchestration/*.test.ts tests/agent/session/*.test.ts",
    "test:agent:planning": "PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 AGENT_DISABLE_LLM=1 TSX_TSCONFIG_PATH=tsconfig.agent-test.json tsc -p tsconfig.agent-test.json && PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 AGENT_DISABLE_LLM=1 TSX_TSCONFIG_PATH=tsconfig.agent-test.json node --import tsx --test tests/agent/planning/*.test.ts tests/agent/planning/*.test.tsx",
    "test:agent:planning:h4b-h4c-h4d": "PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 AGENT_DISABLE_LLM=1 TSX_TSCONFIG_PATH=tsconfig.agent-test.json node --import tsx --test tests/agent/planning/complete-checklist-item-*.test.ts tests/agent/planning/plan-checklist-progress*.test.ts tests/agent/planning/timeline-event-*.test.ts",
    "test:agent:planning:h4d": "PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 AGENT_DISABLE_LLM=1 TSX_TSCONFIG_PATH=tsconfig.agent-test.json node --import tsx --test tests/agent/planning/timeline-event-semantics.test.ts tests/agent/planning/timeline-event-rollback.test.ts",
    "test:agent:schedule": "PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 AGENT_DISABLE_LLM=1 TSX_TSCONFIG_PATH=tsconfig.agent-test.json node --import tsx --test tests/agent/schedule/*.test.ts tests/agent/schedule/*.test.tsx",
    "test:agent:checkpoint": "PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 node --import dotenv/config --import tsx --test tests/integration/langgraph-postgres-checkpointer.test.ts",
    "test:agent:e2e": "PAYLOAD_SECRET=sunnypanel-agent-test-secret-2026 node --import dotenv/config scripts/agent-runtime-e2e.mjs",
    "test:content": "node --import tsx --test tests/content/*.test.ts tests/markdown/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public-site-smoke.spec.ts",
    "test:e2e:public:local": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test tests/e2e/public-site-smoke.spec.ts",
    "test:e2e:release": "playwright test --workers=1 tests/e2e/public-site-smoke.spec.ts tests/e2e/dashboard-agent.spec.ts tests/e2e/dashboard-writing.spec.ts tests/e2e/dashboard-core-linkage.spec.ts",
    "test:migrations:upgrade": "node --import tsx scripts/verify-upgrade-migrations.mjs",
    "smoke:agent": "node --import dotenv/config scripts/agent-smoke.mjs",
    "smoke:release-health": "node scripts/smoke-release-health.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:lexical-to-markdown": "node --import tsx scripts/migrate-lexical-to-markdown.ts",
    "seed": "node --import tsx scripts/seed.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.2",
    "@langchain/langgraph-checkpoint-postgres": "1.0.1",
    "@langchain/openai": "1.1.3",
    "@mdxeditor/editor": "^4.0.0",
    "@payloadcms/db-postgres": "^3.83.0",
    "@payloadcms/live-preview-react": "^3.83.0",
    "@payloadcms/next": "^3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tiptap/extension-code-block-lowlight": "^3.26.0",
    "@tiptap/extension-details": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-mathematics": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/extension-task-item": "^3.26.0",
    "@tiptap/extension-task-list": "^3.26.0",
    "@tiptap/extension-typography": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "graphql": "^16.13.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.4",
    "lowlight": "^3.3.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "payload": "^3.83.0",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
