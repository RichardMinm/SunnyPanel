{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "target": "ES2022",
    "paths": {
      "@/lib/payload/client": ["./tests/stubs/payload-client.ts"],
      "@/lib/payload/workspace": ["./tests/stubs/workspace.ts"],
      "@payload-config": ["./tests/stubs/payload-config.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["tests/agent/**/*.test.ts", "tests/command/**/*.test.ts", "tests/stubs/**/*.ts"],
  "exclude": ["node_modules", ".next", ".agent-test-dist"]
}
