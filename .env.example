NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=<生成一个随机的 64 字符密钥>
POSTGRES_DB=sunnypanel
POSTGRES_USER=<你的数据库用户名>
POSTGRES_PASSWORD=<你的数据库密码>
POSTGRES_PORT=5432
DATABASE_URL=postgresql://<用户>:<密码>@127.0.0.1:5432/<数据库名>

# Agent model configuration. The dashboard Agent first reads Payload Admin's
# Agent Settings global; if that is empty or disabled, it falls back to these.
ZAI_API_KEY=<你的 Z.AI API 密钥>
ZAI_BASE_URL=<你的 Z.AI API 地址>
ZAI_MODEL=<模型名称>

# Optional OpenAI-compatible aliases.
OPENAI_API_KEY=<可选>
OPENAI_BASE_URL=<可选>
OPENAI_MODEL=<可选>
