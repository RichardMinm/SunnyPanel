# ── Required ──
# Generate with: openssl rand -base64 32
# Must be a strong random string. The app WILL NOT start without this in production.
PAYLOAD_SECRET=<生成一个随机的 64 字符密钥，用 openssl rand -base64 32 生成>

# ── Database ──
# Local dev (host → Docker PostgreSQL):
DATABASE_URL=postgresql://<用户>:<密码>@127.0.0.1:5432/<数据库名>
# Docker compose dev (app → compose PostgreSQL):
# DATABASE_URL=postgresql://<用户>:<密码>@postgres:5432/<数据库名>
# Production (use a managed PostgreSQL, e.g. Supabase / Neon / Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

POSTGRES_DB=sunnypanel
POSTGRES_USER=<你的数据库用户名>
POSTGRES_PASSWORD=<你的数据库密码>
POSTGRES_PORT=5432

# ── Server ──
# Local dev:
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Production (MUST be your real HTTPS domain):
# NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# ── Database migration (production MUST be false) ──
PAYLOAD_DB_PUSH=false

# ── Agent LLM ──
# The dashboard Agent reads from Payload Admin > Agent Settings global first;
# falls back to these environment variables when that is empty or disabled.
ZAI_API_KEY=<你的 Z.AI API 密钥>
ZAI_BASE_URL=<你的 Z.AI API 地址>
ZAI_MODEL=<模型名称>

# Optional OpenAI-compatible aliases.
OPENAI_API_KEY=<可选>
OPENAI_BASE_URL=<可选>
OPENAI_MODEL=<可选>

# ── Agent runtime ──
# Default: langgraph. All intents, confirmations and compound orchestration run
# through the PostgreSQL-checkpointed graph. Session messages and pending state
# are persisted in the append-only agent-thread-events stream.
AGENT_GRAPH_RUNTIME=langgraph
# Explicit emergency runtime only; it still writes the shared thread event stream:
# AGENT_GRAPH_RUNTIME=legacy

# ── CORS (production) ──
# Optional: comma-separated list of allowed origins in addition to NEXT_PUBLIC_SERVER_URL.
# CORS_EXTRA_ORIGINS=https://subdomain.example.com,https://other.example.com

# ── Media storage (optional) ──
# For multi-instance deployments, use S3-compatible storage instead of local filesystem:
# S3_ENDPOINT=<your-s3-endpoint>
# S3_BUCKET=<your-bucket>
# S3_ACCESS_KEY=<your-access-key>
# S3_SECRET_KEY=<your-secret-key>
# S3_REGION=<your-region>
